{
  "name": "homeserver",
  "version": "0.1.0",
  "description": "Panel de gestion de serveur web/hébergement",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p server/tsconfig.json",
    "start": "node server/dist/server/src/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit",
    "install-panel": "node scripts/install.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "dotenv": "^18.0.4",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
