# Port d'écoute de l'API
HS_PORT=3000

# Secret JWT (généré par l'installateur : openssl rand -hex 32)
HS_JWT_SECRET=changeme

# Identifiants du compte admin initial (générés par l'installateur)
HS_ADMIN_USER=admin
HS_ADMIN_PASSWORD=changeme

# Utilisateur système dédié au panel (généré aléatoirement à l'installation)
HS_USER=

# Modules activés (séparés par des virgules)
HS_MODULES=system,apache,bind9,users,files,php,ssl,mariadb,cron,backups,firewall,monitor
