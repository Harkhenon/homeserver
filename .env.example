# Port d'écoute de l'API
HS_PORT=3000

# Secret JWT — OBLIGATOIRE en production (généré par l'installateur : openssl rand -hex 32)
# Le panel refuse de démarrer en prod avec une valeur absente ou par défaut.
HS_JWT_SECRET=changeme

# Identifiants du compte admin initial (générés par l'installateur).
# Le mot de passe est migré automatiquement vers un hash scrypt dans HS_AUTH_STORE
# au premier login, puis n'est plus utilisé.
HS_ADMIN_USER=admin
HS_ADMIN_PASSWORD=changeme

# Utilisateur système dédié au panel (généré aléatoirement à l'installation)
HS_USER=

# Modules activés (séparés par des virgules)
HS_MODULES=system,apache,nginx,bind9,users,files,php,ssl,mariadb,cron,backups,firewall,monitor,node

# Store d'authentification : hash scrypt du mot de passe admin + secret TOTP 2FA
# (fichier chmod 600, migré automatiquement depuis HS_ADMIN_PASSWORD au premier login)
HS_AUTH_STORE=/var/lib/homeserver/auth.json

# Cookies de session httpOnly + Secure. En true, le cookie n'est accepté qu'en HTTPS.
# Passe à false uniquement si le panel est servi en HTTP sur un réseau local/VPN de confiance.
HS_SECURE_COOKIES=true
